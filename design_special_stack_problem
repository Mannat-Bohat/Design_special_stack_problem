
#include <iostream> // design special stack problem
#include <stack>
using namespace std;

class SpecialStack {
    stack<long long> s;
    long long mini;

public:
    void push(int data) {
        long long val = data;
        if (s.empty()) {
            s.push(val);
            mini = val;
        }
        else {
            if (val < mini) {
                s.push(2 * val - mini);
                mini = val;
            }
            else {
                s.push(val);
            }
        }
    }

    int pop() {
        if (s.empty()) {
            return -1;
        }
        long long curr = s.top();
        s.pop();

        if (curr >= mini) {
            return (int)curr;
        }
        else {
            int originalMin = (int)mini;
            mini = 2 * mini - curr;
            return originalMin;
        }
    }

    int top() {
        if (s.empty()) {
            return -1;
        }
        long long curr = s.top();
        if (curr < mini) {
            return (int)mini;
        }
        else {
            return (int)curr;
        }
    }

    bool isEmpty() {
        return s.empty();
    }

    int getMin() {
        if (s.empty()) {
            return -1;
        }
        return (int)mini;
    }
};

int main() {
    SpecialStack s;
    int Q;

    // Direct instructions for your terminal window
    cout << "=== SPECIAL STACK TERMINAL ===" << endl;
    cout << "Enter Total Number of Queries (e.g., 5): ";
    if (!(cin >> Q)) return 0;

    while (Q--) {
        cout << "\n[1:Push | 2:Pop | 3:Top | 4:IsEmpty | 5:GetMin]" << endl;
        cout << "Enter Query Type: ";
        int query;
        cin >> query;

        if (query == 1) {
            int data;
            cout << "Enter value to Push: ";
            cin >> data;
            s.push(data);
            cout << "-> Successfully Pushed!" << endl;
        }
        else if (query == 2) {
            cout << "-> Popped Value: " << s.pop() << endl;
        }
        else if (query == 3) {
            cout << "-> Top Value: " << s.top() << endl;
        }
        else if (query == 4) {
            cout << "-> Is Empty? " << (s.isEmpty() ? "True" : "False") << endl;
        }
        else if (query == 5) {
            cout << "-> Minimum Value in Stack: " << s.getMin() << endl;
        }
    }

    cout << "\n=== Execution Completed ===" << endl;
    return 0;
}
